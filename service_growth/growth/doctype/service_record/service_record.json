{
  "doctype": "DocType",
  "name": "Service Record",
  "module": "Growth",
  "autoname": "hash",
  "engine": "InnoDB",
  "field_order": [
    "user_id",
    "service_id",
    "city",
    "channel",
    "opened_at",
    "closed_at",
    "churn_reason",
    "is_mock"
  ],
  "fields": [
    {
      "fieldname": "user_id",
      "label": "用户标识",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "service_id",
      "label": "服务标识",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "city",
      "label": "归属城市",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "channel",
      "label": "获客渠道",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "线上推广\n线下门店\n用户推荐\n合作渠道"
    },
    {
      "fieldname": "opened_at",
      "label": "开通时间",
      "fieldtype": "Datetime",
      "reqd": 1,
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "closed_at",
      "label": "关闭时间",
      "fieldtype": "Datetime",
      "in_list_view": 1,
      "search_index": 1
    },
    {
      "fieldname": "churn_reason",
      "label": "关闭原因",
      "fieldtype": "Select",
      "options": "\n价格因素\n服务体验\n需求结束\n迁移离开\n其他",
      "depends_on": "eval:doc.closed_at",
      "mandatory_depends_on": "eval:doc.closed_at"
    },
    {
      "fieldname": "is_mock",
      "label": "合成数据",
      "fieldtype": "Check",
      "read_only": 1
    }
  ],
  "track_changes": 1,
  "sort_field": "opened_at",
  "sort_order": "DESC",
  "permissions": [
    {
      "role": "Growth Viewer",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    },
    {
      "role": "Growth Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "create": 1,
      "write": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "create": 1,
      "write": 1
    }
  ],
  "description": "每条单据表示一段服务周期；关闭时间为空表示在服。同一用户的城市、渠道保持一致。"
}
